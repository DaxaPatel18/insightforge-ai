# ==============================================================================
# InsightForge AI - Docker Build Context Ignore (.dockerignore)
# Prevents sensitive credentials, databases, backups, user assets, and local
# runtimes from being copied into container images.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Version Control & Repository Config
# ------------------------------------------------------------------------------
.git/
.gitignore
.gitattributes
.github/
.gitlab/

# ------------------------------------------------------------------------------
# 2. Environment Files & Secrets (MUST NEVER BE BAKED INTO IMAGES)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12
id_rsa*
id_ed25519*
secrets/
credentials/

# ------------------------------------------------------------------------------
# 3. SQLite Databases & Backups
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
insightforge.db
backend/insightforge.db
*.backup*
*.bak
*.dump
*.sql
test_pg_data/
backend/test_pg_data/

# ------------------------------------------------------------------------------
# 4. Uploaded User Files & Sensitive Knowledge Documents
# ------------------------------------------------------------------------------
/uploads/*
!/uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
data/uploads/*
!data/uploads/.gitkeep
backend/data/knowledge_docs/*
!backend/data/knowledge_docs/.gitkeep
data/knowledge_docs/*
!data/knowledge_docs/.gitkeep

# ------------------------------------------------------------------------------
# 5. Generated PDF Reports & Executive Artifacts
# ------------------------------------------------------------------------------
/reports/*
!/reports/.gitkeep
backend/reports/*
!backend/reports/.gitkeep
data/reports/*
!data/reports/.gitkeep
backend/data/reports/*
!backend/data/reports/.gitkeep
*.pdf

# ------------------------------------------------------------------------------
# 6. Machine Learning Model Artifacts & Checkpoints
# ------------------------------------------------------------------------------
/models/*
!/models/.gitkeep
backend/models/*
!backend/models/.gitkeep
data/models/*
!data/models/.gitkeep
backend/data/models/*
!backend/data/models/.gitkeep
*.joblib
*.pkl
*.pickle
*.pt
*.pth
*.onnx

# ------------------------------------------------------------------------------
# 7. ChromaDB Persistence & Parquet Embeddings
# ------------------------------------------------------------------------------
/chroma_db/*
!/chroma_db/.gitkeep
backend/chroma_db/*
!backend/chroma_db/.gitkeep
data/chroma_db/*
!data/chroma_db/.gitkeep
backend/data/chroma_db/*
!backend/data/chroma_db/.gitkeep
.chroma/
*.parquet

# ------------------------------------------------------------------------------
# 8. Node Dependencies & Frontend Build Output
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ------------------------------------------------------------------------------
# 9. Python Virtual Environments, Bytecode & Test Caches
# ------------------------------------------------------------------------------
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
backend/.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
backend/audit_results.json

# ------------------------------------------------------------------------------
# 10. IDE, OS Metadata & Temporary Directories
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
temp/
scratch/
docs/
