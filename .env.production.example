# ==============================================================================
# InsightForge AI - Production Environment Configuration Template
# ==============================================================================

# Application Environment (Enforces cryptographic key complexity and strict security checks)
ENVIRONMENT=production

# Cryptographic Secret Key (Generate with: openssl rand -hex 32)
# REQUIRED: Must be at least 32 characters long. Fallbacks and defaults are strictly rejected.
INSIGHTFORGE_SECRET_KEY=replace_with_a_cryptographically_secure_random_64_character_hex_key

# PostgreSQL Database Configuration
# REQUIRED: POSTGRES_PASSWORD must be configured. Hardcoded fallbacks are removed.
POSTGRES_USER=insightforge_admin
POSTGRES_PASSWORD=replace_with_strong_database_password_2026
POSTGRES_DB=insightforge_db
# Host port for Postgres administrative access (bound exclusively to 127.0.0.1 on host)
POSTGRES_EXTERNAL_PORT=5432

# Backend Database Connection String (matches credentials above)
DATABASE_URL=postgresql+psycopg2://insightforge_admin:replace_with_strong_database_password_2026@postgres:5432/insightforge_db

# Database Connection Pool Tuning (Tuned for multi-node / multi-worker concurrency)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# Web & Worker Configuration
# When using embedded ChromaDB (PersistentClient), set BACKEND_WORKERS=1 to prevent SQLite
# lock contention and in-memory cache desynchronization.
# When using an external vector database (CHROMA_SERVER_HOST), scale BACKEND_WORKERS to 4+.
BACKEND_WORKERS=1
BACKEND_PORT=8000
FRONTEND_PORT=80

# ChromaDB Vector Storage Configuration
# Local embedded directory inside container (mounted to shared_chroma volume)
CHROMA_PERSIST_DIR=/app/chroma_db
# External ChromaDB Server (Optional: set for multi-worker / multi-node deployments)
CHROMA_SERVER_HOST=
CHROMA_SERVER_PORT=8000

# External AI Provider Keys (Optional: heuristic fallbacks operate if unprovided)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Frontend Production Origin (Render Static Site URL for CORS configuration)
FRONTEND_ORIGIN=https://insightforge-ai.onrender.com

# Additional CORS Origins (Optional comma-separated origins for custom domains)
ADDITIONAL_CORS_ORIGINS=https://insightforge.yourdomain.com

