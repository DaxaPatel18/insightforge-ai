# ==============================================================================
# InsightForge AI - Local Development Environment Template (.env.example)
# Copy to .env if customizing local development parameters.
# In local development (npm run dev), sensible defaults are automatically used.
# ==============================================================================

# Application Environment (development | production)
ENVIRONMENT=development

# JWT Secret Key (Optional in development; a local dev secret is used if omitted)
# In production, this MUST be set to a secure 32+ character random key.
INSIGHTFORGE_SECRET_KEY=

# Local Database Connection (Optional in development; defaults to SQLite insightforge.db)
# DATABASE_URL=postgresql+psycopg2://insightforge_admin:password@localhost:5432/insightforge_db

# Local Ports
PORT=8000
FRONTEND_PORT=5173

# Optional: External LLM Provider Keys (Heuristic rule-based fallbacks operate if unprovided)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: ChromaDB Configuration
# CHROMA_PERSIST_DIR=
# CHROMA_SERVER_HOST=
# CHROMA_SERVER_PORT=8000
