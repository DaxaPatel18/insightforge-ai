{
  "name": "insightforge-ai",
  "version": "0.3.0",
  "description": "InsightForge AI - Agentic Data Science & Machine Learning Platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:concurrently": "concurrently -n \"backend,frontend\" -c \"blue.bold,cyan.bold\" \"node scripts/start-backend.mjs\" \"npm run dev --prefix frontend\"",
    "dev:backend": "node scripts/start-backend.mjs",
    "dev:frontend": "npm run dev --prefix frontend",
    "check": "node scripts/check.mjs",
    "stop": "node scripts/stop.mjs",
    "build": "npm run build --prefix frontend",
    "test:auth": "node scripts/test-backend.mjs test_auth_e2e_suite.py",
    "test:audit": "node scripts/test-backend.mjs audit_test_suite.py"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
